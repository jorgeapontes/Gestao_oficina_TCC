# ─── SEGURANÇA DO SERVIDOR (Apache) ───────────────────────────────────────────
# Sem listagem de pastas e sem assinatura do servidor nas páginas de erro.
Options -Indexes
ServerSignature Off

# Pastas internas (código, banco, fotos), o repositório git e arquivos ocultos
# nunca são acessíveis diretamente pela URL. As fotos são servidas por comum/foto.php.
RedirectMatch 404 (?i)/(\.git|\.claude|database|includes|uploads)(/|$)
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Dumps de banco, documentação, credenciais, logs, backups e configurações.
<FilesMatch "(?i)\.(sql|md|txt|log|ini|conf|bak|old|orig|swp|tmp|dist|json|lock|ya?ml|env|sh|ps1|bat)$">
    Require all denied
</FilesMatch>
<Files "router.php">
    Require all denied
</Files>

# Tipo correto do manifesto do app (ícones da tela inicial do celular).
<IfModule mod_mime.c>
    AddType application/manifest+json .webmanifest
</IfModule>

# Cabeçalhos de segurança também para arquivos estáticos (CSS, JS, imagens).
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "same-origin"
    Header always unset X-Powered-By
</IfModule>
