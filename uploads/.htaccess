# Fotos enviadas: nunca acessíveis diretamente pela URL. Elas são entregues por
# comum/foto.php, que confere se o usuário logado pode vê-las.
Require all denied
Options -Indexes -ExecCGI
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>
